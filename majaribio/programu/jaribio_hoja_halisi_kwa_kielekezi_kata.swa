// Halisi kamili isiyo sifuri kwa kigezo cha kielekezi -- lazima
// ikataliwe (mdudu wa 2026-09-01: f(5) ilipita kwa sababu halisi
// hubeba enc 0 "aina yoyote" na ukaguzi mkali uliiruka -- SEGV
// wakati wa kukimbia). Halisi 0 PEKEE ni kielekezi tupu na
// hukubaliwa (angalia jaribio_hoja_halisi_sifuri_kielekezi_tupu.swa),
// sawa na tangazo, ugawaji, ulinganishi na rudisha.
// Stage1 pekee: mbegu ya zamani bado inakubali.
n32 f(n32* x) { rudisha *x; }
n32 main() {
    n32 r = f(5);
    rudisha r;
}
