// Mende 139: N8/N16 hasi zilipanuliwa kwa sifuri kwenye upakiaji
// (255 badala ya -1; 127+1 ilikuwa 128 badala ya -128). Sasa upakiaji
// wa aina ndogo zenye ishara unatumia movsx (isiyo ishara: movzx),
// kwenye vigeu vya ndani, vigeu vya ulimwengu, viashiria, safu, na
// vigezo. Stage1 pekee: mbegu bado inapanua kwa sifuri.
N8 g8 = -1;
N16 g16 = -32768;

N32 pokea_n8(N8 v) {
    N32 y = v;
    N32 hasi = -1;
    kama (y == hasi) { rudisha 0; }
    rudisha 1;
}

N32 main() {
    N32 hasi = -1;
    N32 hasi_128 = -128;
    N32 hasi_32768 = -32768;
    N8 x8 = -1;
    N32 y = x8;
    kama (y != hasi) { rudisha 1; }
    N16 x16 = -1;
    y = x16;
    kama (y != hasi) { rudisha 2; }
    N8 p8 = -128;
    y = p8;
    kama (y != hasi_128) { rudisha 3; }
    N16 q16 = -32768;
    y = q16;
    kama (y != hasi_32768) { rudisha 4; }
    N8 kuzidi = 127 + 1;
    y = kuzidi;
    kama (y != hasi_128) { rudisha 5; }
    N16 nzuri = 300;
    y = nzuri;
    kama (y != 300) { rudisha 6; }
    y = g8;
    kama (y != hasi) { rudisha 7; }
    y = g16;
    kama (y != hasi_32768) { rudisha 8; }
    N8 b = -1;
    N8* d = &b;
    y = *d;
    kama (y != hasi) { rudisha 9; }
    N8 safu[2];
    safu[0] = -1;
    y = safu[0];
    kama (y != hasi) { rudisha 10; }
    kama (pokea_n8(x8) != 0) { rudisha 11; }
    rudisha 0;
}
