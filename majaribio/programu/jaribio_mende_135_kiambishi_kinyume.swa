// Mende 135: kiambishi ~ (kanusha biti) kilikataliwa na minyororo
// yote miwili ingawa hati 2.5 inaorodhesha ~. Sasa ~ inafanya kazi:
// kila biti inageuzwa (~0 = -1, ~5 = -6) kwa upana wa operesheni.
N32 main() {
    N32 a = ~0;   kama (a != -1) { rudisha 1; }
    N32 b = ~5;   kama (b != -6) { rudisha 2; }
    N32 c = ~(12 & 10); kama (c != -9) { rudisha 3; }
    N64 d = ~0;   kama (d != -1) { rudisha 4; }
    N64 v = 0; N64 e = ~v; kama (e != -1) { rudisha 5; }
    rudisha 0;
}
