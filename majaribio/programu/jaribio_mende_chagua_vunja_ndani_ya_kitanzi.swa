// vunja ndani ya mkono wa chagua inamaliza KITANZI cha ndani kabisa
// (wakati au kwa — vipimo 6.7), si chagua chenyewe: chagua haina
// mwanguko, hivyo hakuna vunja ya mkono inayohitajika.
N32 main() {
    N32 s = 0;
    N32 i = 0;
    kwa (i = 0; i < 3; i = i + 1) {
        chagua (i) {
            hali 1: vunja;
            sivyo: s = s + 1;
        }
    }
    rudisha s;
}
