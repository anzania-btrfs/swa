// Hoja za D64 kupitia kielekezi cha kazi: aina ya hoja huamuliwa na
// usemi wa hoja (xmm0..xmm7) — kazi inachukua D64 mbili. Matokeo ni
// N32 (matokeo ya D64 hayakubaliki kupitia kielekezi — hati 4.3).
N32 linganisha(D64 a, D64 b) {
    kama (a == b) { rudisha 0; }
    kama (a > b) { rudisha 1; }
    rudisha 2;
}
N32 main() {
    N8* k = &linganisha;
    N32 r = k(4.5, 2.5);
    kama (r != 1) rudisha 1;
    N32 s = k(2.5, 2.5);
    kama (s != 0) rudisha 2;
    N32 t = k(2.5, 4.5);
    kama (t != 2) rudisha 3;
    rudisha 0;
}
