// Mende 21: lebo za usemi/kigezo (hali a + 1) zilikubaliwa lakini
// hazikulingana kamwe (lebo ikawa 0 kwenye kizazi) — jibu baya la
// kimya. C inakataa lebo zisizo za kudumu kwa sauti; Swa inafanya
// vivyo hivyo: lebo lazima iwe halisi ya nambari (chanya au hasi).
N32 main() {
    N32 a = 1; N32 s = 0;
    chagua (2) { hali a + 1: s = 42; sivyo: s = 0; }
    rudisha s;
}
