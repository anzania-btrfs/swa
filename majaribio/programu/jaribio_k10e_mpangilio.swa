// mpangilio.swa — Shughuli za kupanga safu za nambari
//
// Hutoa kazi za kupanga safu kwa mpangilio wa kupanda na kushuka.
// Inatumia aina ya kiputo (bubble sort) kwa urahisi na usahihi.

// Panga safu ya N32 kwa mpangilio wa kupanda.
W0 pangilia_n32(N32* arr, N32 idadi) {
    kama (idadi <= 1) {
        rudisha;
    }
    N32 i = 0;
    wakati (i < idadi - 1) {
        N32 j = 0;
        wakati (j < idadi - i - 1) {
            kama (arr[j] > arr[j + 1]) {
                N32 tmp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = tmp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

// Panga safu ya N32 kwa mpangilio wa kushuka.
W0 pangilia_n32_kushuka(N32* arr, N32 idadi) {
    kama (idadi <= 1) {
        rudisha;
    }
    N32 i = 0;
    wakati (i < idadi - 1) {
        N32 j = 0;
        wakati (j < idadi - i - 1) {
            kama (arr[j] < arr[j + 1]) {
                N32 tmp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = tmp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

// Panga safu ya N64 kwa mpangilio wa kupanda.
W0 pangilia_n64(N64* arr, N32 idadi) {
    kama (idadi <= 1) {
        rudisha;
    }
    N32 i = 0;
    wakati (i < idadi - 1) {
        N32 j = 0;
        wakati (j < idadi - i - 1) {
            kama (arr[j] > arr[j + 1]) {
                N64 tmp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = tmp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

// Panga safu ya N64 kwa mpangilio wa kushuka.
W0 pangilia_n64_kushuka(N64* arr, N32 idadi) {
    kama (idadi <= 1) {
        rudisha;
    }
    N32 i = 0;
    wakati (i < idadi - 1) {
        N32 j = 0;
        wakati (j < idadi - i - 1) {
            kama (arr[j] < arr[j + 1]) {
                N64 tmp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = tmp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}
N32 main() {
    N32 arr[5];
    arr[0] = 50;
    arr[1] = 30;
    arr[2] = 10;
    arr[3] = 40;
    arr[4] = 20;

    // Panga kwa kupanda
    pangilia_n32(arr, 5);
    kama (arr[0] != 10) rudisha 1;
    kama (arr[1] != 20) rudisha 2;
    kama (arr[2] != 30) rudisha 3;
    kama (arr[3] != 40) rudisha 4;
    kama (arr[4] != 50) rudisha 5;

    // Panga kwa kushuka
    pangilia_n32_kushuka(arr, 5);
    kama (arr[0] != 50) rudisha 6;
    kama (arr[1] != 40) rudisha 7;
    kama (arr[2] != 30) rudisha 8;
    kama (arr[3] != 20) rudisha 9;
    kama (arr[4] != 10) rudisha 10;

    rudisha 0;
}
