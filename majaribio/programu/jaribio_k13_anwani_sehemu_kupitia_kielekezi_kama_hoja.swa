// Anwani ya sehemu ya muundo kupitia kielekezi kama hoja ya kazi.
// (Toleo la awali lilitumia safu ya muundo — mbegu haijui safu za
// muundo, ilileta SEGV; kielekezi cha muundo kinafanya kazi minyororo yote miwili.)
muundo Nukta { N32 x; N32 y; }

W0 andika_y_kupitia_anwani(N32* addr, N32 v) {
    *addr = v;
}

N32 main() {
    Nukta n;
    Nukta* p = &n;
    p->x = 10;
    p->y = 20;
    andika_y_kupitia_anwani(&p->y, 42);  // &p->y kama hoja ya kazi
    rudisha n.x + n.y;  // 10 + 42 = 52
}
