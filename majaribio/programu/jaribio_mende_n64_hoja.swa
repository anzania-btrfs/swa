// Mende: halisi kubwa kama hoja ya wito ilikuwa ikiharibu mnyororo wa
// hoja — alama ya "N64 literal" ilikuwa ikiishi kwenye ast_tiga, ambayo
// pia ni kiungo cha mnyororo wa hoja (wito ulikataliwa kwa kosa lisilo
// sahihi au hoja ikakatwa). Hati 2.3 inaahidi N64 — hoja lazima ifike
// kamili (4294967296 + 4294967296 = 8589934592).
N64 jumlisha(N64 a, N64 b) { rudisha a + b; }
N32 main() {
    N64 s = jumlisha(4294967296, 4294967296);
    kama (s == 8589934592) { rudisha 0; }
    rudisha 1;
}
