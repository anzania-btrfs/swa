// jaribio_mende_sret_mlolongo_12: mlolongo wa sret wa baiti 12 —
// matokeo ya wito unaorudisha muundo mkubwa (>8B) yanapopitishwa
// kwa thamani kwa wito mwingine: jumlisha(tengeneza(10)). Kabla:
// kielekezi cha bafa ya sret kilipitishwa moja kwa moja (bila
// nakala) — bafa inayoweza kuandikwa tena na wito unaofuata.
// Mbegu haina hifadhi ya kutosha ya rafu kwa mnyororo huu (SEGV) —
// stage1 pekee.
// Inatarajiwa: 33 (10 + 11 + 12)
muundo Tatu { N32 a; N32 b; N32 c; };

Tatu tengeneza(N32 x) {
    Tatu n;
    n.a = x;
    n.b = x + 1;
    n.c = x + 2;
    rudisha n;
}

N32 jumlisha(Tatu t) {
    rudisha t.a + t.b + t.c;
}

N32 main() {
    rudisha jumlisha(tengeneza(10));
}
