// jaribio_mende_faharisi_hasi: faharisi hasi p[-1] inapaswa kupanuliwa
// kwa ISHARA (cdqe) si kwa sifuri — bila hilo anwani inageuka kuwa
// 0xfffffff8 na kusababisha SEGV.
// Inatarajiwa: 20 (a[1])
N32 main() {
    N32 a[4];
    a[0] = 10;
    a[1] = 20;
    a[2] = 30;
    a[3] = 40;
    N32* p = &a[2];
    rudisha p[-1];
}
