// chagua rahisi: hali mbili + kuanguka hadi rudisha ya mwisho.
// (Kwa mnyororo wa Rust; mbegu haijui neno la chagua — FAIL kwenye MANIFEST.)
N32 kadiria(N32 x) {
    chagua (x) {
        hali 1: rudisha 10;
        hali 2: rudisha 20;
    }
    rudisha 0;
}

N32 main() {
    kama (kadiria(1) != 10) rudisha 1;
    kama (kadiria(2) != 20) rudisha 2;
    kama (kadiria(9) != 0) rudisha 3;
    rudisha 0;
}
