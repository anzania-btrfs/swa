// Ulinganisho — sawa, ndogo, kubwa.
N32 linganisha(N32 a, N32 b) {
    kama (a == b) { rudisha 1; }
    kama (a < b) { rudisha -1; }
    rudisha 0;
}

N32 main() {
    kama (linganisha(3, 3) != 1) rudisha 1;
    kama (linganisha(2, 5) != -1) rudisha 2;
    kama (linganisha(5, 2) != 0) rudisha 3;
    rudisha 0;
}
