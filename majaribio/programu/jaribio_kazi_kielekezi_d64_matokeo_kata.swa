// Matokeo ya wito kupitia kielekezi hayajulikani wakati wa kukusanya
// (yanakuja kwenye eax/rax, si xmm0) — kuyachukulia kama D64 ni
// kosa. Hati 4.3.
D64 maradufu(D64 x) { rudisha x * 2.0; }
N32 main() {
    N8* k = &maradufu;
    D64 r = k(2.0);
    kama (r > 3.9 && r < 4.1) { rudisha 0; }
    rudisha 1;
}
