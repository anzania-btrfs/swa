// endelea kama taarifa ya MOJA KWA MOJA ndani ya mwili wa kwa.
// Zamani mnyororo wa uzalishaji ulikwama (kitanzi kisichoisha):
// lebo ya hatua haikutolewa kwa sababu mnyororo wa mwili ulikatika
// kwenye endelea. Mbegu ni sahihi.
N32 main() {
    N32 s = 0;
    N32 i = 0;
    kwa (i = 0; i < 3; i = i + 1) {
        s = s + 1;
        endelea;
    }
    rudisha s;
}
