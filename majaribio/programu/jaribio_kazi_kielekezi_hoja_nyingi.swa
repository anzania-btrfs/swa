// Wito kupitia kielekezi chenye hoja nyingi (3 za N32) na kazi ya
// hoja mbili; anwani imehifadhiwa kwenye N64. Hati 4.3.
N32 jumlisha3(N32 a, N32 b, N32 c) { rudisha a + b + c; }
N32 tofauti(N32 a, N32 b) { rudisha a - b; }
N32 main() {
    N64 k = &jumlisha3;
    N32 r = k(10, 20, 12);
    kama (r != 42) rudisha 1;
    N8* h = &tofauti;
    N32 s = h(60, 18);
    kama (s != 42) rudisha 2;
    rudisha 0;
}
