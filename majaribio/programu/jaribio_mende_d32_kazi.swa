// jaribio_mende_d32_kazi: kazi ya D32 (parameta na kurudisha).
// Kabla: ABI ya D32 ilitumia movsd badala ya movss kwenye rafu ya
// hoja (na uharibifu wa rafu) — SEGV 139 kwenye uzalishaji. Sasa
// parameta inapakuliwa kwa movss, halisi inabadilishwa D64→D32, na
// matokeo yanarudishwa kwenye xmm0.
// Inatarajiwa: 5 (2.5 * 2.0)
// (stage1 pekee — mbegu bado inaanguka kwenye D32.)
D32 mara_mbili(D32 x) { rudisha x * 2.0; }

N32 main() {
    rudisha mara_mbili(2.5);
}
