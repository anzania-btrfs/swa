// jaribio_mende_orodha_inakua: Orodha inayokua (vipimo 10) — badili
// (realloc) inategemea faharisi hasi p[bi2 - 8]; bila ishara-extension
// ilikuwa SEGV na Orodha haikui kamwe. Hapa uwezo 2 -> 4 -> 8.
// Maktaba imeandikwa ndani (kama majaribio mengine ya programu).
// Inatarajiwa: 10 (0 + 1 + 2 + 3 + 4)
N64 arena_anwani = 0;
N64 arena_nafasi = 0;

N64 sys_mmap(N8* anwani, N64 urefu, N64 ulinzi, N64 bendera, N64 faili) {
    rudisha wito_wa_mfumo(9, anwani, urefu, ulinzi, bendera, faili, 0);
}

N64 ukubwa(N32 aina) {
    kama (aina == 1) { rudisha 1; }
    kama (aina == 2) { rudisha 2; }
    kama (aina == 3) { rudisha 4; }
    kama (aina == 4) { rudisha 8; }
    rudisha 8;
}

N8* tenga(N64 ukubwa) {
    kama (arena_anwani == 0) {
        arena_anwani = sys_mmap(0, 1048576, 3, 34, 0 - 1);
        kama (arena_anwani == 0 - 1) { rudisha 0; }
    }
    kama (ukubwa == 0) { ukubwa = 8; }
    ukubwa = ukubwa + 8;  // nafasi ya ukubwa wa kipande (kwa badili)
    kama (arena_nafasi + ukubwa > 1048576) { rudisha 0; }
    N8* r = arena_anwani + arena_nafasi;
    N8* h = &ukubwa;
    N32 bi = 0;
    wakati (bi < 8) {
        r[bi] = h[bi];
        bi = bi + 1;
    }
    arena_nafasi = arena_nafasi + ukubwa;
    rudisha r + 8;
}

W0 nakili(N8* lengwa, N8* chanzo, N64 n) {
    N64 i = 0;
    wakati (i < n) {
        lengwa[i] = chanzo[i];
        i = i + 1;
    }
}

N8* badili(N8* p, N64 ukubwa) {
    kama (p == 0) { rudisha tenga(ukubwa); }
    kama (ukubwa == 0) { rudisha p; }
    N64 zamani = 0;
    N8* h2 = &zamani;
    N32 bi2 = 0;
    wakati (bi2 < 8) {
        h2[bi2] = p[bi2 - 8];
        bi2 = bi2 + 1;
    }
    N8* r = tenga(ukubwa);
    kama (r == 0) { rudisha 0; }
    N64 nakili_urefu = zamani;
    kama (ukubwa < zamani) { nakili_urefu = ukubwa; }
    nakili(r, p, nakili_urefu);
    rudisha r;
}

muundo Orodha { N32* data; N32 idadi; N32 uwezo; };

Orodha orodha_mpya(N32 uwezo_awali) {
    Orodha o;
    o.data = tenga(ukubwa(N32) * uwezo_awali);
    o.idadi = 0;
    o.uwezo = uwezo_awali;
    rudisha o;
}

W0 orodha_ongeza(Orodha* o, N32 thamani) {
    kama (o->idadi >= o->uwezo) {
        o->uwezo = o->uwezo * 2;
        o->data = badili(o->data, ukubwa(N32) * o->uwezo);
    }
    o->data[o->idadi] = thamani;
    o->idadi = o->idadi + 1;
}

N32 orodha_pata(Orodha* o, N32 faharisi) {
    kama (faharisi < 0 || faharisi >= o->idadi) { rudisha 0; }
    rudisha o->data[faharisi];
}

N32 main() {
    Orodha o = orodha_mpya(2);
    N32 i = 0;
    wakati (i < 5) {
        orodha_ongeza(&o, i);
        i = i + 1;
    }
    rudisha orodha_pata(&o, 0) + orodha_pata(&o, 1) + orodha_pata(&o, 2) + orodha_pata(&o, 3) + orodha_pata(&o, 4);
}
