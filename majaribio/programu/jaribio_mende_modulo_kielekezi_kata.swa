// jaribio_mende_modulo_kielekezi_kata.swa — kielekezi % namba
// kinakataliwa kwa sauti: % si hesabu ya anwani (jumlisha na toa
// ndizo pekee, rekodi 8.9); zamani modulo ya anwani yenyewe
// ilipigwa kimya. stage1 pekee: mbegu bado inakubali — rejesha
// baada ya kugandishwa kwa mbegu mpya.
N32 main() {
    N32 a[4];
    N32* p = a;
    N32 x = p % 4;
    rudisha x;
}
