// jaribio_mende_w0_bila_kianzio.swa — kigeu cha ndani cha W0 BILA
// kianzio kinaendelea kukubalika (tangazo halina thamani ya
// kuhifadhi); kazi za W0 na rudisha za W0 pia. Kianzio kwa W0
// kinakataliwa (jaribio_mende_w0_kianzio_kata) — rekodi 8.3.
N32 tokeo = 0;
W0 ongeza(N32 x) {
    tokeo = tokeo + x;
    rudisha;
}
N32 main() {
    W0 tangazo_tupu;
    ongeza(40);
    W0 tangazo_la_pili;
    ongeza(2);
    kama (tokeo != 42) rudisha 1;
    rudisha 0;
}
