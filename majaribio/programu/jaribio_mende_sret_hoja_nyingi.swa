// jaribio_mende_sret_hoja_nyingi: sret mbili kwenye hoja za wito
// mmoja — tofauti(tengeneza(2), tengeneza(5)). Bafa ya sret ni moja
// kwa fremu; wito wa pili unaandika juu ya matokeo ya kwanza. Kabla:
// hoja zote mbili zilielekeza kwenye bafa ileile iliyoandikwa tena
// (jibu 0 badala ya -9). Sasa matokeo ya kila sret yananakiliwa
// mara moja kwenye bafa ya sret-hoja (panda kwa kila kina).
// Mbegu haina hifadhi ya kutosha ya rafu kwa mnyororo huu (SEGV) —
// stage1 pekee.
// Inatarajiwa: 247 (2+3+4) - (5+6+7) = -9, yaani 247
muundo Tatu { N32 a; N32 b; N32 c; };

Tatu tengeneza(N32 x) {
    Tatu n;
    n.a = x;
    n.b = x + 1;
    n.c = x + 2;
    rudisha n;
}

N32 tofauti(Tatu p, Tatu q) {
    rudisha (p.a + p.b + p.c) - (q.a + q.b + q.c);
}

N32 main() {
    rudisha tofauti(tengeneza(2), tengeneza(5));
}
