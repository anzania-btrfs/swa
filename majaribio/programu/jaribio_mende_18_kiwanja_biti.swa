// Mende 18: &= |= ^= <<= >>= zilikuwa NO-OP kimya — zilikubaliwa,
// zilitoa msimbo usiofanya lo lote, na kigeu kilibaki kisichobadilika.
// += -= *= /= %= zilikuwa zimefanya kazi (zinafanyika hapa pia).
// Kila moja ya aina kumi inajaribiwa, pamoja na N64.
N32 main() {
    N32 a = 5;  a += 3; kama (a != 8) { rudisha 1; }
    N32 b = 5;  b -= 3; kama (b != 2) { rudisha 2; }
    N32 c = 5;  c *= 3; kama (c != 15) { rudisha 3; }
    N32 d = 6;  d /= 2; kama (d != 3) { rudisha 4; }
    N32 e = 7;  e %= 3; kama (e != 1) { rudisha 5; }
    N32 f = 12; f &= 10; kama (f != 8) { rudisha 6; }
    N32 g = 12; g |= 3; kama (g != 15) { rudisha 7; }
    N32 h = 12; h ^= 10; kama (h != 6) { rudisha 8; }
    N32 i = 1;  i <<= 3; kama (i != 8) { rudisha 9; }
    N32 j = 16; j >>= 2; kama (j != 4) { rudisha 10; }
    N64 k = 5000000000; k ^= 1; kama (k != 5000000001) { rudisha 11; }
    N64 l = 5000000000; l <<= 1; kama (l != 10000000000) { rudisha 12; }
    N64 m = 5000000000; m >>= 1; kama (m != 2500000000) { rudisha 13; }
    rudisha 0;
}
