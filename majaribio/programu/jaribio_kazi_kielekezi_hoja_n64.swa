// &jina_la_kazi kama HOJA ya paramu ya N64: anwani ya kazi ni
// thamani ya baiti 8, kama paramu yenyewe (ubaguzi wa 4.3 dhidi ya
// sheria ya 5 — kielekezi dhidi ya namba). Kigezo cha N64
// kinachoshikilia anwani kinaitwa ndani ya endesha.
N32 mbili(N32 x) { rudisha x * 2; }
N32 endesha(N64 op, N32 v) { rudisha op(v); }
N32 main() { rudisha endesha(&mbili, 21); }
