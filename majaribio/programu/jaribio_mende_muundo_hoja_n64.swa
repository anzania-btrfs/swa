// jaribio_mende_muundo_hoja_n64: muundo wa N64 x2 (baiti 16) kwa
// thamani. Kabla: jibu 10 badala ya 30 (sehemu ya pili ilipotea).
// Inatarajiwa: 30 (10 + 20)
muundo Jozi64 { N64 x; N64 y; };

N64 jumlisha(Jozi64 j) {
    rudisha j.x + j.y;
}

N32 main() {
    Jozi64 j;
    j.x = 10;
    j.y = 20;
    rudisha jumlisha(j);
}
