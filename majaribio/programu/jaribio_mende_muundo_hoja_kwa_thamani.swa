// jaribio_mende_muundo_hoja_kwa_thamani: muundo kwa thamani (baiti 8)
// kama hoja ya kazi. Mbegu ilirudisha takataka isiyo na uhakika.
// Inatarajiwa: 12
muundo Nukta { N32 x; N32 y; };

N32 pata_x(Nukta p) {
    rudisha p.x;
}

N32 main() {
    Nukta n;
    n.x = 12;
    n.y = 34;
    rudisha pata_x(n);
}
