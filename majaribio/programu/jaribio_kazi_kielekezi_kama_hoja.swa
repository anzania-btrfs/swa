// Kielekezi cha kazi kinapitishwa kama HOJA ya kazi nyingine na
// kinaitwa huko (paramu ya N8*). Hati 4.3.
N32 nyongeza(N32 x) { rudisha x + 1; }
N32 endesha(N8* kazi, N32 thamani) {
    rudisha kazi(thamani) + kazi(thamani);
}
N32 main() {
    N32 r = endesha(&nyongeza, 20);  // 21 + 21 = 42
    kama (r != 42) rudisha 1;
    rudisha 0;
}
