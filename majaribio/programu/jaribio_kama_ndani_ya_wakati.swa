// kama ndani ya wakati — kurejesha mapema ndani ya kitanzi.
N32 tafuta(N32 n) {
    N32 i = 0;
    wakati (i < n) {
        kama (i == 5) { rudisha i; }
        i = i + 1;
    }
    rudisha -1;
}

N32 main() {
    kama (tafuta(10) != 5) rudisha 1;
    kama (tafuta(2) != -1) rudisha 2;
    rudisha 0;
}
