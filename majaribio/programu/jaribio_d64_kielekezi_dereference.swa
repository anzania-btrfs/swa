// lugha-swa/swa#181 -- D64* (kielekezi kwenda D64) haikufanya kazi
// KABISA: hata tangazo la kigezo peke yake (bila dereference yoyote)
// lilikataliwa kwa "kielekezi kwenye operesheni ya desimali". Chanzo
// cha mzizi: ni_desimali_enc iliangalia familia (D=3) tu, bila
// kuangalia biti ya mshale (kielekezi) -- D64* ina familia ile ile
// D=3, hivyo kila mahali kunakotumia ni_desimali_enc kuamua "xmm au
// GP register?" kilishughulikia kielekezi kama D64 halisi.
husisha { maktaba/kumbukumbu.swa }
N32 main() {
    D64* arr = tenga(ukubwa(D64) * 4);
    *arr = 1.5;
    D64 x = *arr;
    N32 y = x;
    rudisha y;
}
