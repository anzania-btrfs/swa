// lugha-swa/swa#181 -- hesabu ya kielekezi cha D64* (arr + n) lazima
// isongeze kwa VIPENGELE (baiti 8), si kutibiwa kama desimali.
husisha { maktaba/kumbukumbu.swa }
N32 main() {
    D64* arr = tenga(ukubwa(D64) * 4);
    arr[0] = 1.5;
    arr[1] = 2.5;
    D64* p = arr + 1;
    D64 v = *p;
    N32 y = v;
    rudisha y;
}
